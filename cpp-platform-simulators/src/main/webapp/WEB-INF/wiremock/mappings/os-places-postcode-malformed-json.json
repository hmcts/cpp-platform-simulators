    "queryParameters": {
      "postcode": { "equalTo": "SW1A 6AA", "caseInsensitive": true }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "body": "not-json"
  }
}
