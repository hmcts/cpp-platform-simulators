{
  "name": "OS Places match - prefix of 'NEWCASTLE' (min 3 chars, case-insensitive, trailing text allowed)",
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPath": "/search/places/v1/find",
    "queryParameters": {
      "query": { "matches": "(?i)NEW(C(A(S(T(L(E.*)?)?)?)?)?)?" },
      "minMatch": { "matches": ".+" }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "bodyFileName": "os-places-match-success-body-newcastle.json"
  }
}
