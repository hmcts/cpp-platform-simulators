{
  "name": "OS Places match - prefix of 'NEWCASTLE' (min 3 chars, case-insensitive)",
  "request": {
    "method": "GET",
    "urlPath": "/search/places/v1/find",
    "queryParameters": {
      "query": { "matches": "(?i)NEW(C(A(S(T(L(E)?)?)?)?)?)?" },
      "maxresults": { "equalTo": "1" }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "bodyFileName": "os-places-match-success-body-newcastle.json"
  }
}
