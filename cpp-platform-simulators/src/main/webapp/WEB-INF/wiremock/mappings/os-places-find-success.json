{
  "name": "OS Places find - prefix of '10 Downing Street' (min 3 chars, case-insensitive)",
  "request": {
    "method": "GET",
    "urlPath": "/search/places/v1/find",
    "queryParameters": {
      "query": { "matches": "(?i)10 (D(o(w(n(i(n(g( (S(t(r(e(e(t)?)?)?)?)?)?)?)?)?)?)?)?)?)?" },
      "maxresults": { "absent": true }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "bodyFileName": "os-places-success-body.json"
  }
}
