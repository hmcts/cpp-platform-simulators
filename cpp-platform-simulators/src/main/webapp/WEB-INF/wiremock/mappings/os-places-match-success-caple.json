{
  "name": "OS Places match - prefix of '1 CAPLE ROAD' (min 3 chars, case-insensitive)",
  "request": {
    "method": "GET",
    "urlPath": "/search/places/v1/find",
    "queryParameters": {
      "query": { "matches": "(?i)1 C(A(P(L(E( (R(O(A(D)?)?)?)?)?)?)?)?)?" },
      "maxresults": { "equalTo": "1" }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "bodyFileName": "os-places-match-success-body-caple.json"
  }
}
