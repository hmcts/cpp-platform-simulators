{
  "name": "OS Places find - prefix of 'LEICESTER HOUSE' (min 3 chars, case-insensitive)",
  "request": {
    "method": "GET",
    "urlPath": "/search/places/v1/find",
    "queryParameters": {
      "query": { "matches": "(?i)LEI(C(E(S(T(E(R( (H(O(U(S(E)?)?)?)?)?)?)?)?)?)?)?)?" },
      "maxresults": { "absent": true }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "bodyFileName": "os-places-success-body-leicester.json"
  }
}
