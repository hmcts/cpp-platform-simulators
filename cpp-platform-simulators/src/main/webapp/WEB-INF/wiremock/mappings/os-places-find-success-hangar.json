{
  "name": "OS Places find - prefix of 'HANGAR 125' (min 3 chars, case-insensitive)",
  "request": {
    "method": "GET",
    "urlPath": "/search/places/v1/find",
    "queryParameters": {
      "query": { "matches": "(?i)HAN(G(A(R( (1(2(5)?)?)?)?)?)?)?" },
      "maxresults": { "absent": true }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "bodyFileName": "os-places-success-body-hanger.json"
  }
}
